# Copy to .env and fill in. Never commit the filled-in file.
#
# SMTP_HOST          your provider's outgoing mail server
# SMTP_PORT          587 for STARTTLS, 465 for implicit TLS
# SMTP_USERNAME      the mailbox that logs in — enquiries are sent TO this address
# SMTP_PASSWORD      that mailbox's password or app password
# SMTP_FROM_ADDRESS  the address the mail is sent FROM; the account must be
#                    allowed to send as it, or the provider will reject the mail

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sales@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=website@example.com
